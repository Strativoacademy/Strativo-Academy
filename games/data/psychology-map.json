      "id": "marcus_fomo",
      "name": "Marcus - FOMO Interceptor",
      "role": "Impulse Suppression Lead",
      "x": 440,
      "y": 1290,
      "themeColor": "#F59E0B",
      "avatarIcon": "fa-shield-halved",
      "dialogue": "When you see a huge green candle blasting off without you, your FOMO screams 'BUY!'. In this zone, you learn to let it go."
    },
    {
      "id": "coach_seraphina",
      "name": "Seraphina - Tilt Recovery Coach",
      "role": "Biofeedback & Mental Reset",
      "x": 2390,
      "y": 1290,
      "themeColor": "#F43F5E",
      "avatarIcon": "fa-heart-pulse",
      "dialogue": "Tilt occurs when emotional frustration overpowers logical risk rules. When tilt strikes, your single best move is stepping away."
    },
    {
      "id": "interceptor_logan",
      "name": "Logan - Revenge Trading Warden",
