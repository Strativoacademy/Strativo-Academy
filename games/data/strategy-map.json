  "npcs": [
    {
      "id": "mentor_arven",
      "name": "Grand Strategist Arven",
      "role": "Apex Strategy Master",
      "x": 1800,
      "y": 2480,
      "themeColor": "#FCD34D",
      "secondaryColor": "#F59E0B",
      "avatarIcon": "fa-crown",
      "dialogue": "Welcome to Strategy Fortress, trader. You stand at the apex of Strativo World. Here, isolated candlestick patterns and single indicator signals are obsolete. We forge complete, rule-based confluences across structure, zones, risk, and discipline."
    },
    {
      "id": "mentor_mira",
      "name": "Mira - Candlestick Mentor",
      "role": "Price Action Specialist",
      "x": 490,
      "y": 1890,
      "themeColor": "#EF4444",
      "secondaryColor": "#F87171",
      "avatarIcon": "fa-fire-flame-curved",
      "dialogue": "A candlestick is never a standalone trade signal; it is a footprint of immediate orderflow at a key structural location."
