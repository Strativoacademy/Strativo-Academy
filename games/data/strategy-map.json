      "id": "mentor_soren",
      "name": "Soren - S/R Analyst",
      "role": "Horizontal Zone Master",
      "x": 490,
      "y": 940,
      "themeColor": "#10B981",
      "secondaryColor": "#34D399",
      "avatarIcon": "fa-shield-halved",
      "dialogue": "Support and resistance are zones of resting liquidity, not single lines. Look for multi-touch structural rejections and polarity flips."
    },
    {
