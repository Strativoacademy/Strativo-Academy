    {
      "id": "mentor_kael",
      "name": "Kael - Market Structure Master",
      "role": "Trend & Orderflow Master",
      "x": 3110,
      "y": 1890,
      "themeColor": "#3B82F6",
      "secondaryColor": "#60A5FA",
      "avatarIcon": "fa-sitemap",
      "dialogue": "Always align your trades with the higher-timeframe swing structure. Fighting the dominant trend is the primary cause of blown accounts."
